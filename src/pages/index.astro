<script is:inline>
  (function(){var t=localStorage.getItem('nev-theme');if(t){document.documentElement.setAttribute('data-theme',t);}})();
</script>
<style is:global>
  :root{
    --canvas:#f7f7f4; --surface:#f2f1ed; --raised:#e6e5e0; --border:#dedcd6;
    --text:#26251e; --muted:#7a7974; --faint:#a1a19f; --stone:#cdcdc9; --driftwood:#84847e;
    --ember:#f54e00;
    --btn-fill:#26251e; --btn-fill-text:#f7f7f4;
    --s1:#ecebe4; --s2:#d9d7cd; --s3:#c3c1b6; --s4:#aaa89d; --s5:#918f85;
    --l1:#6b6a5f; --l2:#52514a; --l3:#3d3c35; --l4:#2c2b25; --l5:#1e1d18;
    --ring:#a5a49c; --ring-d:#c9c8c1;
    --sans:'Inter',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    --serif:'EB Garamond','Iowan Old Style',Palatino,ui-serif,Georgia,serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  }
  :root[data-theme="dark"]{
    --canvas:#1a1915; --surface:#21201a; --raised:#2a2922; --border:#38372f;
    --text:#f2f1ed; --muted:#a1a19f; --faint:#84847e; --stone:#38372f; --driftwood:#a1a19f;
    --ember:#ff6a24; --btn-fill:#e6e5e0; --btn-fill-text:#26251e;
    --s1:#5a584d; --s2:#4b4941; --s3:#3e3d36; --s4:#33322c; --s5:#2a2924;
    --l1:#f6f3ea; --l2:#e0ddd2; --l3:#c6c3b8; --l4:#a9a79c; --l5:#8d8b81;
    --ring:#77766e; --ring-d:#4f4e46;
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --canvas:#1a1915; --surface:#21201a; --raised:#2a2922; --border:#38372f;
      --text:#f2f1ed; --muted:#a1a19f; --faint:#84847e; --stone:#38372f; --driftwood:#a1a19f;
      --ember:#ff6a24; --btn-fill:#e6e5e0; --btn-fill-text:#26251e;
      --s1:#5a584d; --s2:#4b4941; --s3:#3e3d36; --s4:#33322c; --s5:#2a2924;
      --l1:#f6f3ea; --l2:#e0ddd2; --l3:#c6c3b8; --l4:#a9a79c; --l5:#8d8b81;
      --ring:#77766e; --ring-d:#4f4e46;
    }
  }

  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--canvas);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.5;
    -webkit-font-smoothing:antialiased;transition:background .35s ease,color .35s ease}
  ::selection{background:#8bc4f8;color:#26251e}
  .wrap{max-width:1080px;margin:0 auto;padding-left:24px;padding-right:24px}

  nav{position:sticky;top:0;z-index:30;background:color-mix(in oklab,var(--canvas) 88%,transparent);
    backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
  nav.stuck{border-color:var(--border)}
  .navin{max-width:1080px;margin:0 auto;padding:0 24px;height:60px;display:flex;align-items:center;
    justify-content:space-between;gap:16px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--text)}
  .brand svg{width:22px;height:22px;flex:none}
  .brand span{font-size:14px;font-weight:500;letter-spacing:.1em}
  .navmid{display:flex;align-items:center;gap:28px}
  .navmid a{font-size:14px;color:var(--muted);text-decoration:none;transition:color .15s}
  .navmid a:hover{color:var(--text)}
  .navend{display:flex;align-items:center;gap:10px}
  @media (max-width:880px){.navmid{display:none}}

  .btn{display:inline-flex;align-items:center;gap:8px;font-size:14px;text-decoration:none;
    padding:.7em 1.3em;border-radius:4px;transition:background .15s,opacity .15s}
  .btn.primary{background:var(--btn-fill);color:var(--btn-fill-text)}
  .btn.primary:hover{opacity:.86}
  .btn.secondary{background:var(--raised);color:var(--text)}
  .btn.secondary:hover{background:var(--stone)}

  #themeToggle{background:none;border:1px solid var(--border);border-radius:4px;width:32px;height:32px;
    display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);
    transition:color .15s,border-color .15s}
  #themeToggle:hover{color:var(--text);border-color:var(--stone)}
  #themeToggle svg{width:15px;height:15px}
  .icon-sun{display:none}
  :root[data-theme="dark"] .icon-sun{display:block}
  :root[data-theme="dark"] .icon-moon{display:none}
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]) .icon-sun{display:block}
    :root:not([data-theme="light"]) .icon-moon{display:none}
  }

  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  h1{font-size:clamp(36px,5.6vw,60px);font-weight:400;line-height:1.08;letter-spacing:-.03em;max-width:19ch}
  h1 em{font-style:normal;color:var(--ember)}
  h2{font-size:clamp(26px,3.6vw,34px);font-weight:400;line-height:1.2;letter-spacing:-.02em;max-width:24ch}
  h3{font-size:22px;font-weight:400;line-height:1.3;letter-spacing:-.008em}
  .prose{font-family:var(--serif);font-size:19px;line-height:1.62;color:var(--driftwood);max-width:60ch}
  p.body{font-size:15px;line-height:1.75;color:var(--muted)}

  .hero{padding:clamp(56px,10vh,100px) 0 0}
  .hero .eyebrow{margin-bottom:22px}
  .hero .prose{margin-top:24px}
  .cta-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:32px}

  /* globe — no frame, sits on the canvas */
  .stage{margin-top:clamp(52px,9vh,88px);display:flex;justify-content:center;padding:8px 0 28px}
  .globe-wrap{width:clamp(280px,46vw,420px);cursor:crosshair}
  .globe-wrap svg{width:100%;height:auto;display:block;shape-rendering:crispEdges}
  .stageline{border-top:1px solid var(--border);border-bottom:1px solid var(--border);
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
    padding:14px 0;font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--faint)}
  .stageline b{font-weight:400;color:var(--muted)}
  @media (max-width:600px){.stageline{justify-content:center;text-align:center}}

  .c-s1{fill:var(--s1)} .c-s2{fill:var(--s2)} .c-s3{fill:var(--s3)} .c-s4{fill:var(--s4)} .c-s5{fill:var(--s5)}
  .c-l1{fill:var(--l1)} .c-l2{fill:var(--l2)} .c-l3{fill:var(--l3)} .c-l4{fill:var(--l4)} .c-l5{fill:var(--l5)}
  .c-ring{fill:var(--ring)} .c-ring-d{fill:var(--ring-d)}

  section{padding:clamp(60px,10vh,92px) 0}
  section .eyebrow{margin-bottom:16px}
  section h2+.prose{margin-top:18px}

  .tracks{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:16px;margin-top:40px}
  .track{background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:30px 28px;
    display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:border-color .2s,transform .2s}
  .track:hover{border-color:var(--stone);transform:translateY(-3px)}
  .track .tnum{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--faint);margin-bottom:14px}
  .track h3{margin-bottom:12px}
  .track p{font-size:15px;line-height:1.75;color:var(--muted);flex:1}
  .track .tfoot{margin-top:22px;padding-top:16px;border-top:1px solid var(--border);
    display:flex;align-items:center;justify-content:space-between;gap:12px}
  .track .tmeta{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint)}
  .track .tgo{font-size:14px;color:var(--ember)}

  .lines{margin-top:40px;border-top:1px solid var(--border)}
  .line{display:grid;grid-template-columns:200px 1fr;gap:28px;padding:22px 0;border-bottom:1px solid var(--border);align-items:baseline}
  .line .k{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .line p{font-size:15px;line-height:1.75;color:var(--muted)}
  @media (max-width:640px){.line{grid-template-columns:1fr;gap:8px}}

  .closing{border-top:1px solid var(--border);text-align:center}
  .closing h2,.closing .prose{margin-inline:auto}
  .closing .cta-row{justify-content:center}

  footer{border-top:1px solid var(--border);padding:44px 0 32px}
  .footgrid{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;flex-wrap:wrap}
  .footcol{display:flex;flex-direction:column;gap:9px}
  .footcol .h{font-size:14px;font-weight:500;color:var(--text);margin-bottom:2px}
  .footcol a{font-size:13px;color:var(--muted);text-decoration:none}
  .footcol a:hover{color:var(--text)}
  .footbase{margin-top:40px;padding-top:20px;border-top:1px solid var(--border);
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
    font-family:var(--mono);font-size:12px;color:var(--faint)}
  @media (max-width:700px){.footgrid,.footbase{justify-content:center;text-align:center}.footcol{align-items:center}}

  .rev{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
  .rev.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.rev{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
</style>
</head>
