<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f7f7f4">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Nevarro Technologies</title>
<meta name="description" content="Nevarro Technologies builds custom platforms and AI solutions for companies in specialized industries, and licenses enterprise data rights for research through NEV Research Labs.">
<link rel="canonical" href="https://nevarrotech.com/">
<meta property="og:title" content="Nevarro Technologies">
<meta property="og:description" content="Nevarro Technologies builds custom platforms and AI solutions for companies in specialized industries, and licenses enterprise data rights for research through NEV Research Labs.">
<meta property="og:image" content="https://nevarrotech.com/og.png">
<meta property="og:url" content="https://nevarrotech.com/">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap">
<script is:inline>
  try{var t=localStorage.getItem('nev-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}
</script>
<style is:global>
:root{
  --canvas:#f7f7f4; --surface:#f2f1ed; --raised:#e6e5e0; --border:#dedcd6; --hairline:#e5e3dd;
  --text:#26251e; --muted:#6f6e68; --faint:#9b9a94;
  --ember:#f54e00; --ember-soft:rgba(245,78,0,.09);
  --btn-fill:#26251e; --btn-fill-text:#f7f7f4;
  --sans:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --serif:"EB Garamond","Iowan Old Style",Palatino,ui-serif,Georgia,serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  --r:4px; --page:1080px; --band:44px; --gutter:40px;
  --s1:#ecebe4; --s2:#d9d7cd; --s3:#c3c1b6; --s4:#aaa89d; --s5:#918f85;
  --l1:#6b6a5f; --l2:#52514a; --l3:#3d3c35; --l4:#2c2b25; --l5:#1e1d18;
  --ring:#a5a49c; --ring-d:#c9c8c1;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --canvas:#1a1915; --surface:#1f1e19; --raised:#27261f; --border:#34332c; --hairline:#2c2b24;
  --text:#f2f1ed; --muted:#a3a29c; --faint:#7c7b74;
  --ember:#ff6a24; --ember-soft:rgba(255,106,36,.11);
  --btn-fill:#e6e5e0; --btn-fill-text:#26251e;
  --s1:#5a584d; --s2:#4b4941; --s3:#3e3d36; --s4:#33322c; --s5:#2a2924;
  --l1:#f6f3ea; --l2:#e0ddd2; --l3:#c6c3b8; --l4:#a9a79c; --l5:#8d8b81;
  --ring:#77766e; --ring-d:#4f4e46;
}}
:root[data-theme="dark"]{
  --canvas:#1a1915; --surface:#1f1e19; --raised:#27261f; --border:#34332c; --hairline:#2c2b24;
  --text:#f2f1ed; --muted:#a3a29c; --faint:#7c7b74;
  --ember:#ff6a24; --ember-soft:rgba(255,106,36,.11);
  --btn-fill:#e6e5e0; --btn-fill-text:#26251e;
  --s1:#5a584d; --s2:#4b4941; --s3:#3e3d36; --s4:#33322c; --s5:#2a2924;
  --l1:#f6f3ea; --l2:#e0ddd2; --l3:#c6c3b8; --l4:#a9a79c; --l5:#8d8b81;
  --ring:#77766e; --ring-d:#4f4e46;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:96px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--canvas);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.62;
  -webkit-font-smoothing:antialiased;transition:background .3s ease,color .3s ease}
a{color:inherit;text-decoration:none}
::selection{background:var(--ember);color:#fff}
:focus-visible{outline:1.5px solid var(--ember);outline-offset:3px;border-radius:var(--r)}
.wrap{max-width:var(--page);margin:0 auto;padding-left:32px;padding-right:32px}
h1,h2,h3{margin:0;font-weight:400;line-height:1.12;text-wrap:balance}
h1{font-size:clamp(2.25rem,4.6vw,3.4rem);font-weight:300;letter-spacing:-0.035em;line-height:1.05}
h1 em{font-style:normal;color:var(--ember)}
h2{font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.025em}
h3{font-size:1.1875rem;letter-spacing:-0.012em}
p{margin:0 0 14px;text-wrap:pretty}
.band{padding:var(--band) 0;border-top:1px solid var(--hairline)}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--faint);margin-bottom:12px;text-transform:uppercase}
.lead{font-family:var(--serif);font-size:1.25rem;line-height:1.52;color:var(--muted);max-width:54ch}
.head{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,1fr);column-gap:var(--gutter);align-items:start;margin-bottom:24px}
.head .eyebrow{grid-column:1/-1}
.head h2{grid-column:1;padding-right:8%}
.head .lead{grid-column:2;margin:0;padding-top:.35em}

/* buttons */
.btn{display:inline-block;padding:11px 22px;border-radius:999px;font-size:14px;background:var(--raised);color:var(--text);
  border:1px solid transparent;transition:background .18s ease,border-color .18s ease,opacity .18s ease}
.btn:hover{background:transparent;border-color:var(--border)}
.btn.primary{background:var(--btn-fill);color:var(--btn-fill-text);border-color:var(--btn-fill)}
.btn.primary:hover{opacity:.86}
.actions{display:flex;flex-wrap:wrap;gap:9px}

/* nav */
.nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--canvas) 88%,transparent);
  backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);border-bottom:1px solid var(--hairline)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:24px}
.brand{display:flex;align-items:center;gap:10px;color:var(--text)}
.brand .mk{width:24px;height:24px;flex:none;display:block}
.brand .wm{font-size:13px;letter-spacing:.14em;white-space:nowrap;line-height:1}
.brand .wm b{font-weight:600}
.brand .wm i{font-style:normal;font-weight:300;margin-left:.45em}
.links{display:flex;align-items:center;gap:6px;font-size:14px}
.links a:not(.btn){color:var(--muted);padding:7px 11px;border-radius:var(--r);transition:color .18s ease,background .18s ease;white-space:nowrap}
.links a:not(.btn):hover{color:var(--text);background:var(--surface)}
.links a.on{color:var(--text)}
.links .ext{color:var(--faint);font-size:12px}
.links .btn{margin-left:6px}
.iconbtn{display:flex;align-items:center;justify-content:center;width:32px;height:32px;margin-left:6px;border-radius:var(--r);
  border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;transition:color .18s ease,border-color .18s ease}
.iconbtn:hover{color:var(--text);border-color:var(--faint)}
.iconbtn svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}
.i-sun{display:none}.i-moon{display:block}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .i-sun{display:block}:root:not([data-theme="light"]) .i-moon{display:none}}
:root[data-theme="dark"] .i-sun{display:block}
:root[data-theme="dark"] .i-moon{display:none}
.ticker{border-bottom:1px solid var(--hairline);background:var(--surface)}
.ticker .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:10px;padding-bottom:10px;
  font-family:var(--mono);font-size:11px;color:var(--faint);letter-spacing:.07em;text-transform:uppercase}
.ticker span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#clock{font-variant-numeric:tabular-nums}

/* status pill */
.status{display:inline-flex;align-items:center;gap:10px;padding:8px 14px 8px 11px;border:1px solid var(--border);border-radius:999px;
  font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.status i{width:7px;height:7px;border-radius:50%;background:var(--ember);box-shadow:0 0 0 3px var(--ember-soft);animation:pulse 2.4s ease-in-out infinite;flex:none}
@keyframes pulse{0%,100%{box-shadow:0 0 0 3px var(--ember-soft)}50%{box-shadow:0 0 0 6px transparent}}

/* hairline grids + cards */
.two{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--hairline);border:1px solid var(--hairline);border-radius:var(--r);overflow:hidden}
.card{background:var(--canvas);padding:34px 30px;transition:background .2s ease}
.card h3{font-size:1.25rem;letter-spacing:-0.015em;margin-bottom:12px}
.card p{color:var(--muted);font-size:15px;line-height:1.62;margin:0}
.card .k{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--faint);text-transform:uppercase;margin-bottom:14px}
.lines{border-top:1px solid var(--hairline)}
.line{display:grid;grid-template-columns:220px 1fr;column-gap:var(--gutter);padding:22px 0;border-bottom:1px solid var(--hairline);align-items:baseline}
.line .k{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--faint);text-transform:uppercase}
.line p{margin:0;color:var(--muted);font-size:15px;line-height:1.62}
.line h3{font-size:1.0625rem;font-weight:500;margin-bottom:6px}

/* line-art shared */
.art{display:block;width:100%;height:auto;overflow:visible}
.art .ln{fill:none;stroke:var(--text);stroke-width:1.4;stroke-linejoin:round;stroke-linecap:round}
.art .fl{fill:var(--canvas);stroke:var(--text);stroke-width:1.4;stroke-linejoin:round}
.art .sf{fill:var(--surface);stroke:var(--border);stroke-width:1}
.art .wire{fill:none;stroke:var(--faint);stroke-width:1.1;stroke-dasharray:3 4}
.art .cap{font-family:var(--mono);font-size:10px;letter-spacing:.14em;fill:var(--faint)}
.art .cap.t{fill:var(--text)}
.art .cap.e{fill:var(--ember)}
.art .dot{fill:var(--muted)}
.art .dot.e{fill:var(--ember)}
.art .hub{fill:var(--canvas);stroke:var(--ember);stroke-width:1.2}
.art .cell{fill:var(--text);opacity:.14;animation:cell 3.2s ease-in-out infinite}
.art .cell.hot{fill:var(--ember);opacity:1;animation:hot 3.2s ease-in-out infinite}
.art .scrib{fill:none;stroke:var(--faint);stroke-width:1.3;stroke-linecap:round;stroke-dasharray:60;stroke-dashoffset:60;animation:write 4s ease-in-out infinite}
@keyframes cell{0%,100%{opacity:.12}50%{opacity:.42}}
@keyframes hot{0%,100%{opacity:.25}50%{opacity:1}}
@keyframes write{0%{stroke-dashoffset:60}45%,80%{stroke-dashoffset:0}100%{stroke-dashoffset:-60}}

/* footer */
footer{border-top:1px solid var(--hairline);background:var(--surface)}
.fgrid{display:grid;grid-template-columns:repeat(5,auto);justify-content:space-between;gap:28px 32px;padding:40px 0 32px;font-size:14px}
.fgrid h4{margin:0 0 16px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--faint);font-weight:400;text-transform:uppercase}
.fgrid a.brand{display:flex;padding:0;color:var(--text)}
.fgrid a{display:block;color:var(--muted);padding:5px 0;transition:color .18s ease}
.fgrid a:hover{color:var(--text)}
.fgrid .about{color:var(--muted);max-width:32ch;margin-top:16px;line-height:1.6}
.fgrid a.pledge{display:flex;flex-direction:column;align-items:flex-start;gap:14px;margin-top:28px;padding:0;max-width:250px;color:var(--muted)}
@media (max-width:900px){.fgrid a.pledge{flex-direction:row;align-items:center;max-width:360px}}
.pledge img{width:84px;height:84px;border-radius:50%;display:block;flex:none;box-shadow:0 0 0 1px var(--hairline)}
.pledge span{font-size:13px;line-height:1.5}
.pledge u{text-decoration:none;color:var(--text);border-bottom:1px solid var(--hairline)}
.fgrid a.pledge:hover u{border-color:var(--text)}
.pres{display:flex;flex-direction:column;gap:12px}
.pres div{display:flex;align-items:flex-start;gap:10px;color:var(--muted);line-height:1.45}
.pres img{width:22px;height:16.5px;border-radius:2px;box-shadow:0 0 0 1px var(--hairline);margin-top:3px;flex:none;object-fit:cover}
.pres b{display:block;font-weight:500;color:var(--text)}
.pres span{white-space:nowrap}
.fbar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid var(--hairline);padding:20px 0;
  font-family:var(--mono);font-size:11px;color:var(--faint);letter-spacing:.07em;text-transform:uppercase}

/* secondary pages */
.page-head{padding:40px 0 24px}
.page-head .eyebrow{margin-bottom:18px}
.page-head h1{margin:0 0 22px;max-width:18ch}
.page-head .lead{max-width:60ch}
.prose{max-width:72ch}
.prose h2{font-size:1.375rem;letter-spacing:-.02em;margin:40px 0 12px}
.prose h2:first-child{margin-top:0}
.prose p,.prose li{color:var(--muted);font-size:15.5px;line-height:1.72}
.prose ul,.prose ol{padding-left:20px;margin:0 0 16px}
.prose a,.inl{color:var(--text);border-bottom:1px solid var(--faint);transition:border-color .18s ease}
.prose a:hover,.inl:hover{border-color:var(--ember)}
.stamp{font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--faint);text-transform:uppercase}
.box{border:1px solid var(--hairline);border-radius:var(--r);background:var(--surface);padding:24px 26px;box-shadow:inset 3px 0 0 var(--ember)}
.box p{margin:0;color:var(--muted);font-size:15px;line-height:1.65}
.box p+p{margin-top:10px}
.box b{color:var(--text);font-weight:500}

.rev{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease}
.rev.in{opacity:1;transform:none}

@media (max-width:1100px){.fgrid{grid-template-columns:repeat(3,minmax(0,1fr));justify-content:stretch}.fgrid>div:first-child{grid-column:1/-1}}
@media (max-width:920px){
  :root{--band:36px;--gutter:28px}
  .head{grid-template-columns:1fr;row-gap:16px}
  .head h2{padding-right:0}
  .head .lead{grid-column:1;padding-top:0}
  .two{grid-template-columns:1fr}
}
@media (max-width:680px){
  :root{--band:32px}
  body{font-size:15.5px}
  .wrap{padding-left:22px;padding-right:22px}
  .links a:not(.btn){display:none}
  .ticker .wrap span:last-child{display:none}
  .card{padding:26px 22px}
  .line{grid-template-columns:1fr;row-gap:6px}
  .page-head{padding:28px 0 18px}
}
@media (max-width:680px){.fgrid{grid-template-columns:1fr 1fr}.pres span{white-space:normal}}
@media (max-width:520px){.brand .wm i{display:none}}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *{transition:none!important;animation:none!important}
  .rev{opacity:1;transform:none}
  .art .dot{display:none}
  .art .scrib{stroke-dashoffset:0}
}

/* hero */
.hero{padding:28px 0 32px}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);column-gap:40px;align-items:center}
.hero .eyebrow{margin-bottom:14px}
.hero h1{max-width:17ch;margin-bottom:18px;font-size:clamp(2.1rem,3.9vw,3rem)}
.hero .lead{font-size:1.3125rem;margin-bottom:0;max-width:50ch}
.globe-wrap{justify-self:end;width:100%;max-width:330px;cursor:crosshair}
.globe-wrap svg{width:100%;height:auto;display:block;shape-rendering:crispEdges}
.c-s1{fill:var(--s1)}.c-s2{fill:var(--s2)}.c-s3{fill:var(--s3)}.c-s4{fill:var(--s4)}.c-s5{fill:var(--s5)}
.c-l1{fill:var(--l1)}.c-l2{fill:var(--l2)}.c-l3{fill:var(--l3)}.c-l4{fill:var(--l4)}.c-l5{fill:var(--l5)}
.c-ring{fill:var(--ring)}.c-ring-d{fill:var(--ring-d)}

/* two lines of work */
.line-card{display:flex;flex-direction:column;padding:0;color:inherit}
.line-card .artbox{background:var(--surface);border-bottom:1px solid var(--hairline);padding:20px 34px 14px}
.line-card .body{padding:24px 30px 24px;display:flex;flex-direction:column;flex:1}
.line-card h3{font-size:1.375rem;letter-spacing:-0.02em;margin-bottom:14px}
.line-card .now{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:22px 0 0;padding:14px 0 0;border-top:1px solid var(--hairline);font-size:14px;color:var(--text)}
.line-card .pill{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;padding:4px 9px;border-radius:999px;border:1px solid var(--ember);color:var(--ember)}
.line-card .foot{margin-top:auto;padding-top:22px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.line-card .meta{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
.line-card .go{font-size:14px;color:var(--text);border-bottom:1px solid var(--faint);transition:border-color .18s ease;white-space:nowrap}
.line-card:hover{background:var(--canvas)}
.line-card:hover .go{border-color:var(--ember)}
.line-card:hover .artbox{background:color-mix(in srgb,var(--surface) 70%,var(--raised))}

/* sectors + regions */
.sectors{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--hairline);border:1px solid var(--hairline);border-radius:var(--r);overflow:hidden}
.sector{background:var(--canvas);padding:22px 22px 24px;transition:background .2s ease}
.sector:hover{background:var(--surface)}
.sector h3{font-size:1rem;font-weight:500;letter-spacing:-.005em;margin-bottom:6px}
.sector p{margin:0;font-size:13.5px;line-height:1.55;color:var(--muted)}
.netrow{display:flex;flex-wrap:wrap;gap:8px}
.flagchip{display:inline-flex;align-items:center;gap:8px;padding:6px 13px 6px 9px;border:1px solid var(--border);border-radius:999px;background:var(--canvas);font-size:13.5px;white-space:nowrap}
.flagchip img{width:20px;height:15px;border-radius:2px;box-shadow:0 0 0 1px var(--hairline);display:block;object-fit:cover}

/* pledge — compact strip */
.pledge{background:var(--surface);padding:44px 0}
.pledge-grid{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:28px;align-items:center}
.pledge-grid img{width:72px;height:72px;border-radius:50%;box-shadow:0 0 0 1px var(--hairline);display:block}
.pledge-grid .eyebrow{margin-bottom:8px}
.pledge-grid h3{font-size:1.25rem;letter-spacing:-.015em;margin-bottom:6px}
.pledge-grid p{margin:0;color:var(--muted);font-size:14.5px;max-width:64ch}

.closing{padding:28px 0}
.closing-row{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.closing-row p{margin:0;color:var(--muted);font-size:15.5px}
.closing-row p b{color:var(--text);font-weight:500}

@media (max-width:1000px){.sectors{grid-template-columns:repeat(2,1fr)}}
@media (max-width:920px){
  .hero-grid{grid-template-columns:1fr;row-gap:20px}
  .globe-wrap{justify-self:center;max-width:300px}
  .pledge-grid{grid-template-columns:auto 1fr;gap:22px}
  .pledge-grid .actions{grid-column:1/-1}
}
@media (max-width:680px){
  .hero{padding:20px 0 24px}
  .hero .lead{font-size:1.1875rem}
  .line-card .artbox{padding:22px 20px 16px}
  .line-card .body{padding:24px 22px 26px}
  .sectors{grid-template-columns:1fr}
}
</style>
</head>
