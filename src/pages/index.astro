      <a class="btn primary" href="mailto:adi@nevarrotech.com?subject=Enquiry">Get in touch</a>
    </nav>
  </div>
</header>
<div class="ticker">
  <div class="wrap">
    <span>Nevarro Technologies · Vertical modernization · NEV Research Labs</span>
    <span id="clock">Bengaluru · --:--:-- IST</span>
  </div>
</div>

<main id="top">

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Nevarro Technologies · Bengaluru, India</div>
        <h1>We modernize businesses in <em>deep verticals</em>.</h1>
        <p class="lead">Nevarro works in two ways. We go inside individual companies to modernize how they run and build the software and products their operations need. And through NEV Research Labs, our research and syndication arm, we license commercial rights to enterprise data for research and AI training.</p>
        <div class="actions">
          <a class="btn primary" href="mailto:adi@nevarrotech.com?subject=Enquiry">Talk to us</a>
          <a class="btn" href="#work">What we do</a>
        </div>
      </div>
      <div class="globe-wrap" id="globeWrap" aria-hidden="true">
        <svg viewBox="0 0 660 440">
          <g id="gRingBack" transform="rotate(-16 330 220)"></g>
          <g id="gGlobe"></g>
          <g id="gRingFront" transform="rotate(-16 330 220)"></g>
        </svg>
      </div>
    </div>
  </section>

  <section class="band" id="work">
    <div class="wrap">
      <div class="head rev">
