<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nevarro Technologies — Growth Partners &amp; Applied AI Research</title>
<meta name="description" content="Nevarro partners with companies to transform and scale them toward a strategic outcome, and builds custom AI products for niche industries.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<script is:inline>
  (function(){var t=localStorage.getItem('nev-theme');if(t){document.documentElement.setAttribute('data-theme',t);}})();
</script>
<style is:global>
  :root{
    --parchment:#f7f7f4; --bone:#f2f1ed; --linen:#e6e5e0; --stone:#cdcdc9;
    --mist:#a1a19f; --driftwood:#84847e; --ash:#7a7974; --ink:#26251e;
    --ember:#f54e00; --amber:#c08532;
    --canvas:var(--parchment); --surface:var(--bone); --raised:var(--linen);
    --border:#dedcd6; --text:var(--ink); --muted:var(--ash); --faint:var(--mist);
    --btn-fill:var(--ink); --btn-fill-text:var(--parchment);
    --shadow-card:rgba(0,0,0,.10) 0 24px 60px, rgba(0,0,0,.06) 0 10px 24px;
    --g-sea-hi:#e8e6dd; --g-sea:#c9c7bd; --g-sea-lo:#a3a197;
    --g-land-hi:#57564c; --g-land:#3a3931; --g-land-lo:#22211b;
    --g-ring:#9b9a92; --g-ring-d:#c5c4bd;
    --sans:'Inter',ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    --serif:'EB Garamond','Iowan Old Style',Palatino,ui-serif,Georgia,serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  }
  :root[data-theme="dark"]{
    --canvas:#1a1915; --surface:#21201a; --raised:#2a2922; --border:#38372f;
    --text:#f2f1ed; --muted:#a1a19f; --faint:#84847e; --stone:#38372f;
    --ember:#ff6a24; --amber:#d0973f;
    --btn-fill:var(--linen); --btn-fill-text:#26251e;
    --shadow-card:rgba(0,0,0,.4) 0 24px 60px, rgba(0,0,0,.25) 0 10px 24px;
    --g-sea-hi:#555348; --g-sea:#413f37; --g-sea-lo:#31302a;
    --g-land-hi:#f4f1e8; --g-land:#d2cfc3; --g-land-lo:#9d9b90;
    --g-ring:#74736b; --g-ring-d:#4c4b43;
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --canvas:#1a1915; --surface:#21201a; --raised:#2a2922; --border:#38372f;
      --text:#f2f1ed; --muted:#a1a19f; --faint:#84847e; --stone:#38372f;
      --ember:#ff6a24; --amber:#d0973f;
      --btn-fill:var(--linen); --btn-fill-text:#26251e;
      --shadow-card:rgba(0,0,0,.4) 0 24px 60px, rgba(0,0,0,.25) 0 10px 24px;
      --g-sea-hi:#555348; --g-sea:#413f37; --g-sea-lo:#31302a;
      --g-land-hi:#f4f1e8; --g-land:#d2cfc3; --g-land-lo:#9d9b90;
      --g-ring:#74736b; --g-ring-d:#4c4b43;
    }
  }

  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--canvas); color:var(--text); font-family:var(--sans);
    font-size:16px; line-height:1.5; -webkit-font-smoothing:antialiased;
    transition:background .35s ease,color .35s ease;
  }
  ::selection{background:#8bc4f8;color:#26251e}
  .wrap{max-width:1080px;margin:0 auto;padding-left:24px;padding-right:24px}

  nav{position:sticky;top:0;z-index:30;background:color-mix(in oklab,var(--canvas) 88%,transparent);
    backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
  nav.stuck{border-color:var(--border)}
  .navin{max-width:1080px;margin:0 auto;padding:0 24px;height:60px;
    display:flex;align-items:center;justify-content:space-between;gap:16px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--text)}
  .brand svg{width:22px;height:22px;flex:none}
  .brand span{font-size:14px;font-weight:500;letter-spacing:.1em}
  .navmid{display:flex;align-items:center;gap:28px}
  .navmid a{font-size:14px;color:var(--muted);text-decoration:none;transition:color .15s}
  .navmid a:hover{color:var(--text)}
  .navend{display:flex;align-items:center;gap:10px}
  @media (max-width:880px){.navmid{display:none}}

  .btn{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:400;
    text-decoration:none;padding:.7em 1.3em;border-radius:4px;
    transition:background .15s cubic-bezier(.4,0,.2,1),color .15s,border-color .15s}
  .btn.primary{background:var(--btn-fill);color:var(--btn-fill-text)}
  .btn.primary:hover{opacity:.86}
  .btn.secondary{background:var(--raised);color:var(--text)}
  .btn.secondary:hover{background:var(--stone)}

  #themeToggle{background:none;border:1px solid var(--border);border-radius:4px;
    width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;
    cursor:pointer;color:var(--muted);transition:color .15s,border-color .15s}
  #themeToggle:hover{color:var(--text);border-color:var(--stone)}
  #themeToggle svg{width:15px;height:15px}
  .icon-sun{display:none}
  :root[data-theme="dark"] .icon-sun{display:block}
  :root[data-theme="dark"] .icon-moon{display:none}
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]) .icon-sun{display:block}
    :root:not([data-theme="light"]) .icon-moon{display:none}
  }

  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash)}
  h1{font-size:clamp(36px,5.6vw,60px);font-weight:400;line-height:1.08;letter-spacing:-.03em;max-width:19ch}
  h1 em{font-style:normal;color:var(--ember)}
  h2{font-size:clamp(26px,3.6vw,34px);font-weight:400;line-height:1.2;letter-spacing:-.02em;max-width:24ch}
  h3{font-size:21px;font-weight:400;line-height:1.3;letter-spacing:-.005em}
  .prose{font-family:var(--serif);font-size:19px;line-height:1.6;color:var(--driftwood);max-width:60ch}
  :root[data-theme="dark"] .prose{color:var(--mist)}
  p.body{font-size:15px;line-height:1.7;color:var(--muted)}

  .hero{padding:clamp(56px,10vh,100px) 0 0}
  .hero .eyebrow{margin-bottom:22px}
  .hero .prose{margin-top:24px}
  .cta-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:32px}

  .panel{margin-top:clamp(44px,7vh,72px);background:var(--surface);border:1px solid var(--border);
    border-radius:4px;box-shadow:var(--shadow-card);overflow:hidden}
  .panel .bar{display:flex;align-items:center;gap:7px;padding:11px 14px;border-bottom:1px solid var(--border)}
  .panel .bar i{width:9px;height:9px;border-radius:50%;background:var(--stone);display:block}
  .panel .bar em{font-family:var(--mono);font-size:12px;color:var(--faint);font-style:normal;margin-left:8px}
  .panel .stage{display:flex;align-items:center;justify-content:center;padding:clamp(26px,4vw,44px) 24px}
  .globe-wrap{width:clamp(240px,40vw,360px)}
  .globe-wrap svg{width:100%;height:auto;display:block;shape-rendering:crispEdges}
  .panel .caption{border-top:1px solid var(--border);padding:14px 20px;font-family:var(--mono);
    font-size:12px;color:var(--faint);text-align:center}

  .c-sea-hi{fill:var(--g-sea-hi)}
  .c-sea{fill:var(--g-sea)}
  .c-sea-lo{fill:var(--g-sea-lo)}
  .c-land-hi{fill:var(--g-land-hi)}
  .c-land{fill:var(--g-land)}
  .c-land-lo{fill:var(--g-land-lo)}
  .c-ring{fill:var(--g-ring)}
  .c-ring-d{fill:var(--g-ring-d)}

  .strip{border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-top:clamp(52px,8vh,80px)}
  .strip .inner{max-width:1080px;margin:0 auto;padding:18px 24px;display:flex;gap:28px;flex-wrap:wrap;
    justify-content:center;font-family:var(--mono);font-size:12px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--faint)}

  section{padding:clamp(60px,10vh,92px) 0}
  section .eyebrow{margin-bottom:16px}
  section h2+.prose{margin-top:18px}

  .tracks{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;margin-top:40px}
  .track{background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:28px 26px;
    transition:border-color .2s}
  .track:hover{border-color:var(--stone)}
  .track .tnum{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--faint);margin-bottom:14px}
  .track h3{margin-bottom:12px}
  .track p{font-size:15px;line-height:1.75;color:var(--muted)}
  .track .tlist{margin-top:18px;padding-top:16px;border-top:1px solid var(--border);
    font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--faint);line-height:2}

  .lines{margin-top:40px;border-top:1px solid var(--border)}
  .line{display:grid;grid-template-columns:180px 1fr;gap:28px;padding:24px 0;
    border-bottom:1px solid var(--border);align-items:baseline}
  .line .k{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ash)}
  .line p{font-size:15px;line-height:1.75;color:var(--muted)}
  @media (max-width:640px){.line{grid-template-columns:1fr;gap:8px}}

  .closing{border-top:1px solid var(--border);text-align:center}
  .closing h2,.closing .prose{margin-inline:auto}
  .closing .cta-row{justify-content:center}

  footer{border-top:1px solid var(--border);padding:44px 0 32px}
  .footgrid{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;flex-wrap:wrap}
  .footcol{display:flex;flex-direction:column;gap:9px}
  .footcol .h{font-size:14px;font-weight:500;color:var(--text);margin-bottom:2px}
  .footcol a{font-size:13px;color:var(--ash);text-decoration:none}
  .footcol a:hover{color:var(--text)}
  .footbase{margin-top:40px;padding-top:20px;border-top:1px solid var(--border);
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
    font-family:var(--mono);font-size:12px;color:var(--faint)}
  @media (max-width:700px){.footgrid,.footbase{justify-content:center;text-align:center}
    .footcol{align-items:center}}

  .rev{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
  .rev.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){
    .rev{opacity:1;transform:none;transition:none}
    html{scroll-behavior:auto}
  }
</style>
</head>
<body>

<nav id="nav">
  <div class="navin">
    <a class="brand" href="#top">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <rect x="5" y="8" width="30" height="27" rx="11" fill="none" stroke="currentColor" stroke-width="2.4"/>
        <circle cx="15" cy="21" r="3" fill="currentColor"/>
        <circle cx="25" cy="21" r="3" fill="currentColor"/>
        <line x1="20" y1="8" x2="20" y2="4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        <circle cx="20" cy="3.5" r="2" fill="currentColor"/>
      </svg>
      <span>NEVARRO</span>
    </a>
    <div class="navmid">
      <a href="#tracks">Two tracks</a>
      <a href="#approach">How we partner</a>
      <a href="#focus">Focus</a>
      <a href="/support">Support</a>
    </div>
    <div class="navend">
      <button id="themeToggle" aria-label="Toggle theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><line x1="12" y1="1.5" x2="12" y2="3.5"/><line x1="12" y1="20.5" x2="12" y2="22.5"/><line x1="4.5" y1="4.5" x2="5.9" y2="5.9"/><line x1="18.1" y1="18.1" x2="19.5" y2="19.5"/><line x1="1.5" y1="12" x2="3.5" y2="12"/><line x1="20.5" y1="12" x2="22.5" y2="12"/><line x1="4.5" y1="19.5" x2="5.9" y2="18.1"/><line x1="18.1" y1="5.9" x2="19.5" y2="4.5"/></svg>
