</div></footer>

<script>
  window.addEventListener('scroll',function(){
    document.getElementById('nav').classList.toggle('stuck',window.scrollY>8);
  });
  (function(){
    var io=new IntersectionObserver(function(en){
      en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});
    },{threshold:.12,rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.rev').forEach(function(el){io.observe(el)});
  })();
  document.getElementById('themeToggle').addEventListener('click',function(){
    var r=document.documentElement,c=r.getAttribute('data-theme');
    if(!c){c=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}
    var n=c==='dark'?'light':'dark';
    r.setAttribute('data-theme',n);localStorage.setItem('nev-theme',n);
  });

  /* ---------- voxel globe + ring ---------- */
  (function(){
    var NS='http://www.w3.org/2000/svg';
    var gG=document.getElementById('gGlobe'),
        gB=document.getElementById('gRingBack'),
        gF=document.getElementById('gRingFront');
    if(!gG) return;

    var cx=300, cy=200, c=9, HALF=20, R=HALF*c;
    var x0=cx-HALF*c, y0=cy-HALF*c;
    var D=Math.PI/180, TILT=20*D, sT=Math.sin(TILT), cT=Math.cos(TILT);

    function ell(la,lo,a0,o0,ar,orr){
      var d=((lo-o0+540)%360)-180, u=(la-a0)/ar, v=d/orr;
      return u*u+v*v<=1;
    }
    function land(la,lo){
      if(la<-64) return true;
      if(ell(la,lo,73,-42,10,17)) return true;
      if(ell(la,lo,58,-102,13,42)) return true;
      if(ell(la,lo,40,-99,12,26)) return true;
      if(ell(la,lo,64,-152,7,17)) return true;
      if(ell(la,lo,21,-101,8,12)) return true;
      if(ell(la,lo,13,-86,5,10)) return true;
      if(ell(la,lo,-4,-62,14,13)) return true;
      if(ell(la,lo,-30,-63,16,8)) return true;
      if(ell(la,lo,20,8,15,22)) return true;
      if(ell(la,lo,-8,20,20,14)) return true;
      if(ell(la,lo,8,42,7,7)) return true;
      if(ell(la,lo,-20,46,6,3)) return true;
      if(ell(la,lo,49,14,11,22)) return true;
      if(ell(la,lo,63,17,7,13)) return true;
      if(ell(la,lo,27,45,12,14)) return true;
      if(ell(la,lo,53,90,20,52)) return true;
      if(ell(la,lo,64,130,10,50)) return true;
      if(ell(la,lo,21,79,12,10)) return true;
      if(ell(la,lo,8,107,13,13)) return true;
      if(ell(la,lo,37,138,7,4)) return true;
      if(ell(la,lo,-25,134,11,18)) return true;
      if(ell(la,lo,-41,173,6,4)) return true;
      return false;
    }

    var Lx=-0.44,Ly=0.36,Lz=0.82;
    var Ln=Math.sqrt(Lx*Lx+Ly*Ly+Lz*Lz); Lx/=Ln; Ly/=Ln; Lz/=Ln;

    var cells=[];
    for(var j=0;j<HALF*2;j++){
      for(var i=0;i<HALF*2;i++){
        var px=x0+i*c, py=y0+j*c;
        var nx=(px+c/2-cx)/R, ny=-(py+c/2-cy)/R;
        var rho2=nx*nx+ny*ny;
        if(rho2>0.99) continue;
        var nz=Math.sqrt(1-rho2);
        var r=document.createElementNS(NS,'rect');
        r.setAttribute('x',px); r.setAttribute('y',py);
        r.setAttribute('width',c); r.setAttribute('height',c);
        gG.appendChild(r);
        cells.push({el:r,nx:nx,ny:ny,nz:nz,d:nx*Lx+ny*Ly+nz*Lz,cls:''});
      }
    }

    function paint(lon0){
      for(var k=0;k<cells.length;k++){
        var q=cells[k];
        var yw=q.ny*cT + q.nz*sT;
        var zw=-q.ny*sT + q.nz*cT;
        var la=Math.asin(Math.max(-1,Math.min(1,yw)))/D;
        var lo=((lon0 + Math.atan2(q.nx,zw)/D + 540)%360)-180;
        var isL=land(la,lo);
        var t=q.d>0.62?0:(q.d>0.18?1:2);
        var cls=isL?(t===0?'c-land-hi':t===1?'c-land':'c-land-lo')
                   :(t===0?'c-sea-hi':t===1?'c-sea':'c-sea-lo');
        if(cls!==q.cls){q.cls=cls; q.el.setAttribute('class',cls);}
      }
    }
    paint(0);
    if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
      var lon=0;
      setInterval(function(){ lon=(lon+4)%360; paint(lon); },200);
    }

    var seen={};
    var bands=[{fr:1.40,fy:0.350,cls:'c-ring-d'},
               {fr:1.53,fy:0.383,cls:'c-ring'},
               {fr:1.66,fy:0.415,cls:'c-ring-d'}];
    bands.forEach(function(b){
      for(var a=0;a<Math.PI*2;a+=0.010){
        var px=cx+R*b.fr*Math.cos(a), py=cy+R*b.fy*Math.sin(a);
        var gx=x0+Math.round((px-x0-c/2)/c)*c;
        var gy=y0+Math.round((py-y0-c/2)/c)*c;
        var back=Math.sin(a)<0;
        var key=gx+'_'+gy+'_'+(back?'b':'f');
        if(seen[key]) continue;
        seen[key]=1;
        var rr=document.createElementNS(NS,'rect');
        rr.setAttribute('x',gx); rr.setAttribute('y',gy);
        rr.setAttribute('width',c); rr.setAttribute('height',c);
        rr.setAttribute('class',b.cls);
        (back?gB:gF).appendChild(rr);
      }
    });
  })();
</script>

</body>
</html>
