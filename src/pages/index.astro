<script is:inline>
  window.addEventListener('scroll',function(){var n=document.getElementById('nav');if(n)n.classList.toggle('stuck',window.scrollY>8);});
  (function(){
    var el=document.getElementById('clock');if(!el)return;
    var f=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Kolkata',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
    function tick(){el.textContent='Bengaluru · '+f.format(new Date())+' IST';}
    tick();setInterval(tick,1000);
  })();
  (function(){
    /* Real coastlines: Natural Earth 110m land, rasterised to 128x64. */
    var LAND_MASK='';
    var MW=128,MH=64,NS='http://www.w3.org/2000/svg';
    var gG=document.getElementById('gGlobe'),gB=document.getElementById('gRingBack'),gF=document.getElementById('gRingFront'),wrap=document.getElementById('globeWrap');
    if(!gG)return;
    var cx=330,cy=220,c=6,HALF=32,R=HALF*c,x0=cx-HALF*c,y0=cy-HALF*c;
    var D=Math.PI/180,TILT=20*D,sT=Math.sin(TILT),cT=Math.cos(TILT);
    var bits=null;
    if(LAND_MASK.length===MW*MH/4){bits=new Uint8Array(MW*MH);
      for(var i=0;i<LAND_MASK.length;i++){var v=parseInt(LAND_MASK[i],16);bits[i*4]=(v>>3)&1;bits[i*4+1]=(v>>2)&1;bits[i*4+2]=(v>>1)&1;bits[i*4+3]=v&1;}}
    function ell(la,lo,a0,o0,ar,orr){var d=((lo-o0+540)%360)-180,u=(la-a0)/ar,w=d/orr;return u*u+w*w<=1;}
    function landEll(la,lo){
      if(la<-64)return true;
      return ell(la,lo,73,-42,10,17)||ell(la,lo,58,-102,13,42)||ell(la,lo,40,-99,12,26)||ell(la,lo,64,-152,7,17)||
        ell(la,lo,21,-101,8,12)||ell(la,lo,13,-86,5,10)||ell(la,lo,-4,-62,14,13)||ell(la,lo,-30,-63,16,8)||
        ell(la,lo,20,8,15,22)||ell(la,lo,-8,20,20,14)||ell(la,lo,8,42,7,7)||ell(la,lo,-20,46,6,3)||
        ell(la,lo,49,14,11,22)||ell(la,lo,63,17,7,13)||ell(la,lo,27,45,12,14)||ell(la,lo,53,90,20,52)||
        ell(la,lo,64,130,10,50)||ell(la,lo,21,79,12,10)||ell(la,lo,8,107,13,13)||ell(la,lo,37,138,7,4)||
        ell(la,lo,-25,134,11,18)||ell(la,lo,-41,173,6,4);
    }
    function land(la,lo){if(!bits)return landEll(la,lo);
      var col=Math.floor((lo+180)/360*MW),row=Math.floor((90-la)/180*MH);
      col=Math.max(0,Math.min(MW-1,col));row=Math.max(0,Math.min(MH-1,row));return bits[row*MW+col]===1;}
    function norm(v){var n=Math.sqrt(v.x*v.x+v.y*v.y+v.z*v.z);v.x/=n;v.y/=n;v.z/=n;return v;}
    var DEF={x:-0.44,y:0.36,z:0.82},L=norm({x:DEF.x,y:DEF.y,z:DEF.z}),T=norm({x:DEF.x,y:DEF.y,z:DEF.z});
    var cells=[];
    for(var j=0;j<HALF*2;j++){for(var i=0;i<HALF*2;i++){
      var px=x0+i*c,py=y0+j*c,nx=(px+c/2-cx)/R,ny=-(py+c/2-cy)/R,rho2=nx*nx+ny*ny;
      if(rho2>0.995)continue;
      var r=document.createElementNS(NS,'rect');
      r.setAttribute('x',px);r.setAttribute('y',py);r.setAttribute('width',c);r.setAttribute('height',c);
      gG.appendChild(r);cells.push({el:r,nx:nx,ny:ny,nz:Math.sqrt(1-rho2),cls:''});
    }}
    function tone(d){return d>0.80?1:d>0.52?2:d>0.22?3:d>-0.04?4:5;}
    function paint(lon0){
      for(var k=0;k<cells.length;k++){var q=cells[k];
        var yw=q.ny*cT+q.nz*sT,zw=-q.ny*sT+q.nz*cT;
        var la=Math.asin(Math.max(-1,Math.min(1,yw)))/D,lo=((lon0+Math.atan2(q.nx,zw)/D+540)%360)-180;
        var cls=(land(la,lo)?'c-l':'c-s')+tone(q.nx*L.x+q.ny*L.y+q.nz*L.z);
        if(cls!==q.cls){q.cls=cls;q.el.setAttribute('class',cls);}}
    }
    var lon=0;paint(0);
    if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
      setInterval(function(){lon=(lon+3)%360;L.x+=(T.x-L.x)*.25;L.y+=(T.y-L.y)*.25;L.z+=(T.z-L.z)*.25;norm(L);paint(lon);},160);
      wrap.addEventListener('mousemove',function(e){
        var b=wrap.getBoundingClientRect(),mx=((e.clientX-b.left)/b.width)*660,my=((e.clientY-b.top)/b.height)*440;
        var x=(mx-cx)/R,y=-(my-cy)/R,m=Math.sqrt(x*x+y*y);if(m>1){x/=m;y/=m;m=1;}
        T=norm({x:x*.9,y:y*.9,z:Math.max(.35,Math.sqrt(1-m*m*.81))});
      });
      wrap.addEventListener('mouseleave',function(){T=norm({x:DEF.x,y:DEF.y,z:DEF.z});});
    }
    var seen={},bands=[{fr:1.46,fy:0.36,cls:'c-ring-d'},{fr:1.56,fy:0.385,cls:'c-ring'},{fr:1.62,fy:0.40,cls:'c-ring-d'}];
    bands.forEach(function(b){for(var a=0;a<Math.PI*2;a+=0.008){
      var px=cx+R*b.fr*Math.cos(a),py=cy+R*b.fy*Math.sin(a);
      var gx=x0+Math.round((px-x0-c/2)/c)*c,gy=y0+Math.round((py-y0-c/2)/c)*c;
      var back=Math.sin(a)<0,key=gx+'_'+gy+'_'+(back?'b':'f');if(seen[key])continue;seen[key]=1;
      var rr=document.createElementNS(NS,'rect');
      rr.setAttribute('x',gx);rr.setAttribute('y',gy);rr.setAttribute('width',c);rr.setAttribute('height',c);
      rr.setAttribute('class',b.cls);(back?gB:gF).appendChild(rr);}});
  })();
</script>
