<script is:inline>
  window.addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('stuck',window.scrollY>8);});
  (function(){
    var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.rev').forEach(function(el){io.observe(el)});
  })();
  document.getElementById('themeToggle').addEventListener('click',function(){
    var r=document.documentElement,c=r.getAttribute('data-theme');
    if(!c){c=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}
    var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);localStorage.setItem('nev-theme',n);
  });

  /* clock — Bengaluru, IST */
  (function(){
    var el=document.getElementById('clock');
    var f=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Kolkata',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
    function tick(){el.innerHTML='Bengaluru · <b>'+f.format(new Date())+'</b> IST';}
    tick();setInterval(tick,1000);
  })();

  /* ---------- globe ---------- */
  (function(){
    /* Paste the hex string from mask.mjs between the quotes. Empty = ellipse fallback. */
    var LAND_MASK='';
    var MW=128,MH=64;

    var NS='http://www.w3.org/2000/svg';
    var gG=document.getElementById('gGlobe'),gB=document.getElementById('gRingBack'),gF=document.getElementById('gRingFront'),wrap=document.getElementById('globeWrap');
    if(!gG) return;

    var cx=330,cy=220,c=6,HALF=32,R=HALF*c;      /* 64 cells across */
    var x0=cx-HALF*c,y0=cy-HALF*c;
    var D=Math.PI/180,TILT=20*D,sT=Math.sin(TILT),cT=Math.cos(TILT);

    var bits=null;
    if(LAND_MASK.length===MW*MH/4){
      bits=new Uint8Array(MW*MH);
      for(var i=0;i<LAND_MASK.length;i++){var v=parseInt(LAND_MASK[i],16);bits[i*4]=(v>>3)&1;bits[i*4+1]=(v>>2)&1;bits[i*4+2]=(v>>1)&1;bits[i*4+3]=v&1;}
    }
    function ell(la,lo,a0,o0,ar,orr){var d=((lo-o0+540)%360)-180,u=(la-a0)/ar,v=d/orr;return u*u+v*v<=1;}
    function landEll(la,lo){
      if(la<-64) return true;
      return ell(la,lo,73,-42,10,17)||ell(la,lo,58,-102,13,42)||ell(la,lo,40,-99,12,26)||ell(la,lo,64,-152,7,17)||
        ell(la,lo,21,-101,8,12)||ell(la,lo,13,-86,5,10)||ell(la,lo,-4,-62,14,13)||ell(la,lo,-30,-63,16,8)||
        ell(la,lo,20,8,15,22)||ell(la,lo,-8,20,20,14)||ell(la,lo,8,42,7,7)||ell(la,lo,-20,46,6,3)||
        ell(la,lo,49,14,11,22)||ell(la,lo,63,17,7,13)||ell(la,lo,27,45,12,14)||ell(la,lo,53,90,20,52)||
        ell(la,lo,64,130,10,50)||ell(la,lo,21,79,12,10)||ell(la,lo,8,107,13,13)||ell(la,lo,37,138,7,4)||
        ell(la,lo,-25,134,11,18)||ell(la,lo,-41,173,6,4);
    }
    function land(la,lo){
      if(!bits) return landEll(la,lo);
      var col=Math.floor((lo+180)/360*MW),row=Math.floor((90-la)/180*MH);
      if(col<0)col=0;if(col>=MW)col=MW-1;if(row<0)row=0;if(row>=MH)row=MH-1;
      return bits[row*MW+col]===1;
    }

    /* light: default upper-left, follows cursor over the globe */
    var L={x:-0.44,y:0.36,z:0.82},T={x:-0.44,y:0.36,z:0.82};
    function norm(v){var n=Math.sqrt(v.x*v.x+v.y*v.y+v.z*v.z);v.x/=n;v.y/=n;v.z/=n;return v;}
    norm(L);norm(T);

    var cells=[];
    for(var j=0;j<HALF*2;j++){for(var i=0;i<HALF*2;i++){
      var px=x0+i*c,py=y0+j*c;
      var nx=(px+c/2-cx)/R,ny=-(py+c/2-cy)/R,rho2=nx*nx+ny*ny;
      if(rho2>0.995) continue;
      var nz=Math.sqrt(1-rho2);
      var r=document.createElementNS(NS,'rect');
      r.setAttribute('x',px);r.setAttribute('y',py);r.setAttribute('width',c);r.setAttribute('height',c);
      gG.appendChild(r);
      cells.push({el:r,nx:nx,ny:ny,nz:nz,cls:''});
    }}

    function tone(d){return d>0.80?1:d>0.52?2:d>0.22?3:d>-0.04?4:5;}
    function paint(lon0){
      for(var k=0;k<cells.length;k++){
        var q=cells[k];
        var yw=q.ny*cT+q.nz*sT,zw=-q.ny*sT+q.nz*cT;
        var la=Math.asin(Math.max(-1,Math.min(1,yw)))/D;
        var lo=((lon0+Math.atan2(q.nx,zw)/D+540)%360)-180;
        var d=q.nx*L.x+q.ny*L.y+q.nz*L.z;
        var cls=(land(la,lo)?'c-l':'c-s')+tone(d);
        if(cls!==q.cls){q.cls=cls;q.el.setAttribute('class',cls);}
      }
    }

    var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var lon=0;
    paint(0);
    if(!reduce){
      setInterval(function(){
        lon=(lon+3)%360;
        L.x+=(T.x-L.x)*.25;L.y+=(T.y-L.y)*.25;L.z+=(T.z-L.z)*.25;norm(L);
        paint(lon);
      },160);
      wrap.addEventListener('mousemove',function(e){
        var b=wrap.getBoundingClientRect();
        var mx=((e.clientX-b.left)/b.width)*660,my=((e.clientY-b.top)/b.height)*440;
        var x=(mx-cx)/R,y=-(my-cy)/R;
        var m=Math.sqrt(x*x+y*y);if(m>1){x/=m;y/=m;m=1;}
        T={x:x*.9,y:y*.9,z:Math.max(.35,Math.sqrt(1-m*m*.81))};norm(T);
      });
      wrap.addEventListener('mouseleave',function(){T={x:-0.44,y:0.36,z:0.82};norm(T);});
    }

    /* ring — thinner, same grid */
    var seen={};
    var bands=[{fr:1.46,fy:0.36,cls:'c-ring-d'},{fr:1.56,fy:0.385,cls:'c-ring'},{fr:1.62,fy:0.40,cls:'c-ring-d'}];
    bands.forEach(function(b){
      for(var a=0;a<Math.PI*2;a+=0.008){
        var px=cx+R*b.fr*Math.cos(a),py=cy+R*b.fy*Math.sin(a);
        var gx=x0+Math.round((px-x0-c/2)/c)*c,gy=y0+Math.round((py-y0-c/2)/c)*c;
        var back=Math.sin(a)<0,key=gx+'_'+gy+'_'+(back?'b':'f');
        if(seen[key]) continue;seen[key]=1;
        var rr=document.createElementNS(NS,'rect');
        rr.setAttribute('x',gx);rr.setAttribute('y',gy);rr.setAttribute('width',c);rr.setAttribute('height',c);
        rr.setAttribute('class',b.cls);(back?gB:gF).appendChild(rr);
      }
    });
  })();
</script>

</body>
</html>
